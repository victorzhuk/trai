import { Button, ScrollView, VerticalBox, HorizontalBox, LineEdit, ComboBox } from "std-widgets.slint";

// One row in the transcript panel. The Rust side rebuilds `[TranscriptRow]`
// from the Pipeline's live-view snapshot on each Segment update, then hands it
// to `set_transcript_rows` so late updates can replace pending text by index.
// `degraded` marks a translation served by a fallback backend; `error` marks
// a misconfigured backend's rejection surfaced in place of a translation.
export struct TranscriptRow {
    speaker: string,
    timestamp: string,
    text: string,
    translation: string,
    degraded: bool,
    error: bool,
}

export component AppWindow inherits Window {
    title: "trai";
    preferred-width: 600px;
    preferred-height: 400px;

    in property <[TranscriptRow]> transcript-rows;
    in property <bool> recording-active: false;
    in property <string> status-text: "stopped";

    // Wizard state. `wizard-open` is flipped on by start-clicked after
    // enumerating sources, and off by begin/cancel. Hidden while a
    // recording is in flight.
    in property <bool> wizard-open: false;
    in-out property <string> wizard-title: "";
    in-out property <[string]> mic-source-names;
    in-out property <int> mic-selected-index: 0;
    in-out property <[string]> monitor-source-names;
    in-out property <int> monitor-selected-index: 0;
    in property <string> store-root-display: "";

    callback start-clicked();
    callback stop-clicked();
    callback begin-clicked();
    callback cancel-wizard-clicked();

    VerticalBox {
        HorizontalBox {
            Button {
                text: "Start";
                enabled: !root.recording-active;
                clicked => { root.start-clicked(); }
            }
            Button {
                text: "Stop";
                enabled: root.recording-active;
                clicked => { root.stop-clicked(); }
            }
            Text {
                text: root.recording-active ? "Recording" : root.status-text;
            }
        }

        // In-place wizard panel: shown only when the user has opened it
        // and no recording is active. Replaces the transcript area for
        // the duration of source selection.
        if root.wizard-open && !root.recording-active: VerticalBox {
            Text {
                text: "New recording";
                font-weight: 700;
            }
            LineEdit {
                placeholder-text: "Title";
                text <=> root.wizard-title;
            }
            Text { text: "Microphone"; }
            ComboBox {
                model <=> root.mic-source-names;
                current-index <=> root.mic-selected-index;
            }
            Text { text: "Monitor"; }
            ComboBox {
                model <=> root.monitor-source-names;
                current-index <=> root.monitor-selected-index;
            }
            Text { text: "Store root: " + root.store-root-display; }
            HorizontalBox {
                Button {
                    text: "Begin";
                    clicked => { root.begin-clicked(); }
                }
                Button {
                    text: "Cancel";
                    clicked => { root.cancel-wizard-clicked(); }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                for row in root.transcript-rows: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    Text { text: row.speaker; min-width: 42px; max-width: 42px; }
                    Text { text: row.timestamp; min-width: 48px; max-width: 48px; }
                    Text { text: row.text; horizontal-stretch: 1; min-width: 0px; }
                    Text {
                        text: row.error ? "✕" : row.degraded ? "⚠" : "";
                        min-width: 18px;
                        max-width: 18px;
                        color: row.error ? red : row.degraded ? #b45309 : black;
                    }
                    Text {
                        text: row.translation;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        color: row.error ? red : row.degraded ? #b45309 : black;
                    }
                }
            }
        }
    }
}

