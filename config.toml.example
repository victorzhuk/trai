# Template configuration for trai. Copy this file to config.toml at the
# repository root and replace every placeholder with values for your
# machine before running the app.

store_root = "/home/you/.local/share/trai/recordings"
mic_source = "alsa_input.pci-0000_00_1f.3.analog-stereo"
monitor_source = "alsa_output.pci-0000_00_1f.3.analog-stereo.monitor"
# Optional per-Stream language overrides. Omit either one (or both) to
# let the transcriber auto-detect the language of each Stream from the
# audio. Set a code (ISO 639-1 or a full language name) to force that
# Stream's language instead of detecting it.
# mic_language = "en"
# monitor_language = "de"
whisper_url = "http://localhost:9000"
target_language = "en"
vad_threshold = 0.5
silence_hold_ms = 300
# Hard ceiling on a single segment's duration. A segment that runs
# longer than this is force-closed and a new one opens at the boundary.
duration_cap_ms = 30000
# How often to cut ongoing speech for live transcription. During
# continuous speech a new segment is closed and transcribed every
# this many milliseconds, so text appears while the speaker is
# still talking. Set this equal to duration_cap_ms to disable
# mid-speech chunking and only transcribe after silence.
live_chunk_ms = 3000
confidence_floor = 0.6

[translate]
# Applied to every backend below; the reachable one may still be slow
# (large local models can take tens of seconds per request), so this
# should comfortably exceed your slowest backend's typical response time.
request_timeout_ms = 60000
# How long a degraded fallback chain waits before re-probing an earlier,
# higher-priority backend to see whether it has come back.
reprobe_interval_ms = 30000

# Backends are tried in order. The first one that answers wins; if it
# starts failing, translation falls over to the next and keeps retrying
# the earlier ones in the background at reprobe_interval_ms.
[[translate.backends]]
base_url = "http://192.168.1.50:1234"
model = "qwen/qwen3.5-9b"
# api_key = "optional-bearer-token"

[[translate.backends]]
base_url = "http://localhost:11434"
model = "qwen3.5:cloud"
